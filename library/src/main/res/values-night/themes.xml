
<resources>
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
    </style>

    <style name="Theme.AppTheme.MaterialPreference">
        <item name="android:paddingStart">@dimen/preference_padding_start</item>
        <item name="android:paddingEnd">@dimen/preference_padding_end</item>
        <item name="android:paddingTop">@dimen/preference_padding_top</item>
        <item name="android:paddingBottom">@dimen/preference_padding_bottom</item>
    </style>

    <style name="Theme.AppTheme.MaterialDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="dialogCornerRadius">28dp</item>
        <item name="android:background">@drawable/dialog_bg</item>
    </style>

    <style name="Theme.AppTheme.MaterialPreferenceHeaderSwitch" parent="Theme.AppTheme.MaterialPreference">
        <item name="background">@drawable/header_switch_bg</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Theme.AppTheme.MaterialPreference.Icon">
        <item name="android:tint">?colorOnSurface</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:layout_marginEnd">24dp</item>
    </style>

    <style name="Theme.AppTheme.MaterialPreference.Summary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:tint">?colorOnSurface</item>
        <item name="android:layout_gravity">fill</item>
    </style>

    <style name="Theme.AppTheme.MaterialPreference.Switch">
        <item name="track">@drawable/switch_track</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
    </style>

    <style name="Theme.AppTheme.MaterialPreferencesFragment">
        <item name="android:layout">@layout/fragment_preferences</item>
    </style>

    <style name="Theme.AppTheme.MaterialPreferencesFragment.Style">
        <item name="android:background">?colorSurface</item>
        <item name="android:layout_marginBottom">24dp</item>
    </style>

    <style name="Theme.AppTheme.MaterialPreferencesFragment.Title" parent="@style/TextAppearance.Material3.HeadlineLarge">
        <item name="android:paddingTop">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:textSize">36sp</item>
    </style>

    <style name="Theme.AppTheme.MaterialPreferenceCategory">
        <item name="android:layout">@layout/material_preference_category</item>
    </style>

    <style name="Theme.AppTheme.MaterialPreferenceCategory.Text" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?colorPrimary</item>
        <item name="android:padding">@dimen/preference_category_padding</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>
